#!/bin/sh

set -eu

MODEL_DIR="/usr/share/alt-ai-rescue/models"
MODEL_FILE="$MODEL_DIR/Agents-A1-4B-Q4_K_M.gguf"
PART_FILE="$MODEL_FILE.part"
MODEL_URL="https://huggingface.co/InternScience/Agents-A1-4B-Q4_K_M-GGUF/resolve/main/Agents-A1-4B-Q4_K_M.gguf?download=true"

install -d -m 0755 "$MODEL_DIR"

if [ -s "$MODEL_FILE" ]; then
    echo "ALT AI Rescue model is already installed."
    exit 0
fi

echo "Downloading ALT AI Rescue model..."

if ! curl -fL --retry 3 -C - -o "$PART_FILE" "$MODEL_URL"; then
    echo "Model download failed. Run this command to retry:"
    echo "/usr/lib/alt-ai-rescue/alt-ai-rescue-download-model"
    exit 1
fi

mv -f "$PART_FILE" "$MODEL_FILE"
chmod 0644 "$MODEL_FILE"

echo "ALT AI Rescue model installed successfully."
