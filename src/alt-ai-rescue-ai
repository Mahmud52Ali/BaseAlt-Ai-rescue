#!/bin/sh

set -u

PERSISTENT_LOG_DIR="/var/log/alt-ai-rescue"
RUNTIME_LOG_DIR="/run/alt-ai-rescue"
PERSISTENT_FINDINGS="$PERSISTENT_LOG_DIR/findings-latest.json"
RUNTIME_FINDINGS="$RUNTIME_LOG_DIR/findings-latest.json"

if [ -r "$RUNTIME_FINDINGS" ] && {
    [ ! -r "$PERSISTENT_FINDINGS" ] ||
    [ "$RUNTIME_FINDINGS" -nt "$PERSISTENT_FINDINGS" ]
}; then
    LOG_DIR="$RUNTIME_LOG_DIR"
    FINDINGS="$RUNTIME_FINDINGS"
else
    LOG_DIR="$PERSISTENT_LOG_DIR"
    FINDINGS="$PERSISTENT_FINDINGS"
fi

if [ ! -r "$FINDINGS" ]; then
    echo "AI analysis input not found:"
    echo "$PERSISTENT_FINDINGS"
    echo "$RUNTIME_FINDINGS"
    echo
    echo "Run 'Run analysis' from the rescue menu first."
    exit 1
fi

cd "$LOG_DIR" || exit 1

PYTHONPATH="/usr/lib/alt-ai-rescue${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec /usr/bin/python3 -m ai_agent.ai_agent
