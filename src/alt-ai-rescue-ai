#!/bin/sh

set -u

PERSISTENT_LOG_DIR="/var/log/alt-ai-rescue"
RUNTIME_LOG_DIR="/run/alt-ai-rescue"
PERSISTENT_FINDINGS="$PERSISTENT_LOG_DIR/findings-latest.json"
RUNTIME_FINDINGS="$RUNTIME_LOG_DIR/findings-latest.json"
LLAMA_HEALTH_URL="http://127.0.0.1:8080/health"

if [ -r "$RUNTIME_FINDINGS" ] && {
    [ ! -r "$PERSISTENT_FINDINGS" ] ||
    [ "$RUNTIME_FINDINGS" -nt "$PERSISTENT_FINDINGS" ]
}; then
    LOG_DIR="$RUNTIME_LOG_DIR"
    FINDINGS="$RUNTIME_FINDINGS"
else
    LOG_DIR="$PERSISTENT_LOG_DIR"
    FINDINGS="$PERSISTENT_FINDINGS"
fi

if [ ! -r "$FINDINGS" ]; then
    echo "AI analysis input not found:"
    echo "$PERSISTENT_FINDINGS"
    echo "$RUNTIME_FINDINGS"
    echo
    echo "Run 'Run analysis' from the rescue menu first."
    exit 1
fi

if ! systemctl is-active --quiet alt-ai-rescue-llama.service; then
    echo "Starting llama.cpp server..."
    systemctl start alt-ai-rescue-llama.service || true
fi

echo "Waiting for llama.cpp server..."

if ! /usr/bin/python3 - "$LLAMA_HEALTH_URL" <<'PY'
import sys
import time
import urllib.request


url = sys.argv[1]
deadline = time.monotonic() + 300

while time.monotonic() < deadline:
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            if 200 <= response.status < 300:
                raise SystemExit(0)
    except Exception:
        time.sleep(1)

raise SystemExit(1)
PY
then
    echo
    echo "llama.cpp server did not become ready."
    echo "Check: systemctl status alt-ai-rescue-llama.service"
    exit 1
fi

cd "$LOG_DIR" || exit 1

PYTHONPATH="/usr/lib/alt-ai-rescue${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH

exec /usr/bin/python3 -m ai_agent.ai_agent
